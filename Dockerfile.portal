FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY packages ./packages

RUN npm ci
RUN npm run build:portal --workspace @chunkforge/desktop

EXPOSE 8080

ENV PORT=8080
ENV HOST=0.0.0.0
ENV CHUNKFORGE_DATA=/data

CMD ["npm", "run", "start", "--workspace", "@chunkforge/api"]
