# Chunkforge Web — the Chunkforge UI in Docker.
#
# The same interface the desktop app ships, served over HTTP with the Core API
# behind it. Set CHUNKFORGE_EMBEDDED_NODE=true to also run a Chunkforge Node
# inside this container, which is what a single-box homelab wants.
FROM node:22-bookworm-slim

# Servers run as real java processes when the embedded node is on, so the image
# carries a JRE. Chunkforge still downloads a matching JDK per server when a
# version needs one the image does not have.
RUN apt-get update \
  && apt-get install -y --no-install-recommends openjdk-17-jre-headless ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages ./packages

RUN npm ci
RUN npm run build --workspace @chunkforge/web

EXPOSE 8080

ENV PORT=8080
ENV HOST=0.0.0.0
ENV CHUNKFORGE_DATA=/data

CMD ["npm", "run", "start", "--workspace", "@chunkforge/web"]
