{
  "name": "@chunkforge/node-worker",
  "version": "0.5.1",
  "description": "Chunkforge Node — runs servers and reaches Chunkforge through a Portal, with no inbound ports",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chunkforge/api": "*",
    "@chunkforge/core": "*",
    "@chunkforge/portal": "*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
