{
  "name": "@chunkforge/desktop",
  "version": "0.5.4",
  "description": "Chunkforge desktop shell",
  "main": "./out/main/index.js",
  "author": "Chunkforge",
  "homepage": "https://github.com/scopeddlol/chunkforge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:portal": "vite build -c vite.portal.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "icon": "node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@chunkforge/api": "*",
    "@chunkforge/core": "*",
    "@chunkforge/portal": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "@fluentui/react-components": "^9.54.15",
    "@fluentui/react-icons": "^2.0.257",
    "electron-updater": "^6.3.9",
    "sharp": "^0.35.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  }
}
