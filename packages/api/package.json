{
  "name": "@chunkforge/api",
  "version": "0.7.0",
  "description": "Chunkforge Core API \u2014 HTTP + WebSocket over @chunkforge/core",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch src/standalone.ts",
    "start": "tsx src/standalone.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chunkforge/core": "*",
    "@chunkforge/portal": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "ws": "^8.18.0",
    "@chunkforge/node-worker": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2"
  }
}
