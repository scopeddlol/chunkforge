{
  "name": "@chunkforge/api",
  "version": "0.5.4",
  "description": "Chunkforge Core API — HTTP + WebSocket over @chunkforge/core",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch src/standalone.ts",
    "start": "tsx src/standalone.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@chunkforge/core": "*",
    "@chunkforge/portal": "*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
