# --- Portal (VPS) ---
# Required. The domain Portal is reached at; Caddy gets a certificate for it,
# and Portal uses it as its public base URL. Point its DNS here first.
CHUNKFORGE_PORTAL_DOMAIN=portal.example.com

# Optional. Pre-seeds the zone subdomains are allocated under on first boot.
# Editable afterwards under Portal → Settings.
CHUNKFORGE_PORTAL_ZONE=play.example.com

# Optional. A Cloudflare API token scoped to Zone → DNS → Edit on the zone
# above — Portal then publishes the wildcard and every server's DNS records
# itself instead of only reporting them under Subdomains. Leave unset to keep
# doing it by hand, or set it later from Portal → Settings → Cloudflare DNS.
CHUNKFORGE_CLOUDFLARE_API_TOKEN=
# Defaults to CHUNKFORGE_PORTAL_ZONE if omitted.
CHUNKFORGE_CLOUDFLARE_ZONE_NAME=

# Player traffic range. Must match Portal → Settings → port range, and must be
# open on the VPS firewall. Every server on every node is funnelled through it.
CHUNKFORGE_RANGE_START=25600
CHUNKFORGE_RANGE_END=25699

# --- Nodes and Chunkforge Web ---
# Where the Portal is reachable, from the node's point of view. Use https://
# and the domain above — not a raw IP, or TLS verification will fail.
CHUNKFORGE_PORTAL_URL=https://portal.example.com
# A node pin from Portal → Nodes. Single-use, expires in 30 minutes.
CHUNKFORGE_PAIRING_PIN=
CHUNKFORGE_NODE_NAME=Chunkforge Node

# --- Chunkforge Web (homelab) ---
CHUNKFORGE_WEB_PORT=8080
# Run a node inside the Web container as well as the panel.
CHUNKFORGE_EMBEDDED_NODE=false
